# Banco de dados MySQL. Em producao use um MySQL 8 gerenciado (externo ao Render).
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/faciliteidb?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=troque-esta-senha

# Cookies de sessao e CSRF.
# Local (http://localhost): SECURE=false e SAME_SITE=lax.
# Producao cross-origin (front no Vercel, API no Render): SECURE=true e SAME_SITE=none.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Origens permitidas (CORS e WebSocket). Em producao, use SOMENTE o dominio do front.
# Ex.: https://SEU-FRONT.vercel.app
MYAPP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
AWS_S3_BUCKET=
# Recomendado: dominio CloudFront, sem barra no final.
AWS_S3_PUBLIC_BASE_URL=
# Opcional para LocalStack/MinIO em desenvolvimento.
AWS_S3_ENDPOINT=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# URLs do front (dominio do Vercel em producao).
RESET_PASSWORD_URL=http://localhost:5173/reset-password
APP_FRONTEND_URL=http://localhost:5173

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MONTHLY_AMOUNT_CENTS=2990
MERCADOPAGO_REASON=Facilitei - plano profissional

# Web Push (VAPID). Gere um par exclusivo por ambiente: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:contato@facilitei.app

# Contas com acesso ao painel /admin (separe por virgula).
APP_ADMIN_EMAILS=

RATE_LIMIT_ENABLED=true
PASSWORD_MIGRATION_ENABLED=true
